{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clearcheolgeo",
  "main": "worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // 대시보드에서 직접 넣은 변수를 배포 시 지우지 않는다.
  "keep_vars": true,
  // 매일 03:00(UTC) Supabase 에 가벼운 요청을 보내 무료 플랜 자동 일시정지(7일 무활동)를 막는다.
  "triggers": { "crons": ["0 3 * * *"] },
  // 커스텀 도메인 — DNS 레코드와 HTTPS 인증서는 Cloudflare 가 자동 생성한다.
  "routes": [
    { "pattern": "www.clearcheolgeo.com", "custom_domain": true },
    { "pattern": "clearcheolgeo.com", "custom_domain": true }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://www.clearcheolgeo.com",
    "SUPABASE_URL": "https://zvrddrvrbarqzovobhrf.supabase.co"
  }
}
