# 클리어철거 홈페이지 환경변수 예시
# 이 파일을 .env.local 로 복사한 뒤 값을 채워 주세요. (.env.local 은 저장소에 커밋하지 않습니다)

# ── 사이트 주소 ─────────────────────────────────────────────
# 도메인 연결 후 주석을 유지한 채 값을 확인하세요. (배포 서버의 환경변수에도 동일하게 설정) 설정 시 canonical / OG / sitemap.xml 이 생성됩니다.
# 미설정 상태에서는 가짜 도메인을 만들지 않기 위해 sitemap 이 비어 있습니다.
NEXT_PUBLIC_SITE_URL=https://www.clearcheolgeo.com

# ── 관리자 인증 (필수) ──────────────────────────────────────
# 설정하지 않으면 /admin 과 /api/admin 은 503 으로 차단되어 누구도 접수 내용을 볼 수 없습니다.
ADMIN_USER=
ADMIN_PASSWORD=

# ── 접수 데이터 저장 위치 ───────────────────────────────────
# 미설정 시 <프로젝트>/data 에 저장됩니다. 운영 시에는 백업되는 영구 볼륨 경로를 지정하세요.
# QUOTE_DATA_DIR=/var/lib/clear-demolition/data

# ── 접속 IP 해시 솔트 ───────────────────────────────────────
# 스팸 방지용 IP 해시에 사용합니다. 운영 환경에서는 임의의 긴 문자열로 설정하세요.
# IP_HASH_SALT=

# ── 새 접수 알림 (선택) ─────────────────────────────────────
# 설정하면 접수 시 해당 URL 로 알림만 POST 합니다. (이름/연락처/주소/문의내용은 전송하지 않습니다)
# 미설정 시 알림은 발송되지 않으며, 관리자 화면에서 직접 확인해야 합니다.
# QUOTE_NOTIFY_WEBHOOK_URL=

# ── 개발용 ──────────────────────────────────────────────────
# 시공사례 테스트 데이터를 개발 환경에서만 보이게 합니다. 운영에서는 설정하지 마세요.
# NEXT_PUBLIC_SHOW_SAMPLE_PROJECTS=1
