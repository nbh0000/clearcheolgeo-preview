# 클리어철거 홈페이지 환경변수 예시
# 이 파일을 .env.local 로 복사한 뒤 값을 채워 주세요. (.env.local 은 저장소에 커밋하지 않습니다)

# ── 데이터베이스 (필수) ─────────────────────────────────────
# 견적문의 접수 내용과 첨부 사진이 저장되는 곳입니다.
# 설정하지 않으면 온라인 접수를 받지 않고 전화상담 안내가 표시됩니다.
# (저장되지 않는데 접수된 것처럼 보이지 않도록 서버에서도 접수를 거부합니다)
#
# ※ 클라우드타입은 디스크 마운트를 지원하지 않아 컨테이너에 파일로 저장할 수 없습니다.
#    반드시 외부 PostgreSQL(자동 백업이 되는 관리형 서비스)을 사용하세요.
DATABASE_URL=postgresql://사용자:비밀번호@호스트:5432/DB이름

# 자체 서명 인증서를 쓰는 DB 에 연결할 때만 1 로 설정합니다.
# (인증서 검증을 끄므로 꼭 필요한 경우에만 사용하세요)
# DATABASE_SSL_INSECURE=

# 커넥션 풀 최대 개수 (기본 5). 무료 요금제 DB 는 동시 접속 수 제한이 낮을 수 있습니다.
# DATABASE_POOL_MAX=5

# ── 관리자 인증 (필수) ──────────────────────────────────────
# 설정하지 않으면 /admin 과 /api/admin 은 503 으로 차단되어 누구도 접수 내용을 볼 수 없습니다.
ADMIN_USER=
ADMIN_PASSWORD=

# ── 접속 IP 해시 솔트 ───────────────────────────────────────
# 스팸 방지용 IP 해시에 사용합니다. 임의의 긴 문자열로 설정하고 이후 변경하지 마세요.
IP_HASH_SALT=

# ── 사이트 주소 ─────────────────────────────────────────────
# 도메인 연결 후 설정하고 재배포하면 canonical / OG / sitemap.xml 이 생성됩니다.
# 미설정 상태에서는 가짜 도메인을 만들지 않기 위해 sitemap 이 비어 있습니다.
# ※ NEXT_PUBLIC_ 로 시작하는 값은 빌드 시점에 반영되므로 변경 후 반드시 재배포해야 합니다.
NEXT_PUBLIC_SITE_URL=https://www.clearcheolgeo.com

# ── 새 접수 알림 (선택) ─────────────────────────────────────
# 설정하면 접수 시 해당 URL 로 알림만 POST 합니다. (이름/연락처/주소/문의내용은 전송하지 않습니다)
# 미설정 시 알림은 발송되지 않으며, /admin 에서 직접 확인해야 합니다.
# QUOTE_NOTIFY_WEBHOOK_URL=

# ── 개발용 ──────────────────────────────────────────────────
# 시공사례 테스트 데이터를 개발 환경에서만 보이게 합니다. 운영에서는 설정하지 마세요.
# NEXT_PUBLIC_SHOW_SAMPLE_PROJECTS=1
